@prefix dpv: <https://w3id.org/dpv#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://w3id.org/examples#> .


ex:AutomatedReimbursement a dpv:PersonalDataHandling ;
    dct:title "Automated Healthcare Reimbursement" ;
    
    dpv:hasPurpose eu-ehds:ReimbursementServicesProvision, 
                    eu-ehds:AdministrativeServicesProvision ;
    
    dpv:hasPersonalData ex:ReimbursementClaimData ;
    
    # the legal basis is the performance of the contact with the insurance or legal obligation between patient and insurer
    dpv:hasLegalBasis dpv:ContractPerformance ;
    
    dpv:hasOrganisationalMeasure dpv:PrivacyByDesign ;
    
    dpv:hasStatus dpv:ActivityOngoing ;
    
    dct:description "Automated transmission of billing information to insurance providers to settle healthcare costs."@en .

ex:ReimbursementClaimData a dpv:PersonalData ;
    dct:title "Reimbursement Claim Dataset" ;
    dct:description "Reimbursement Claim Dataset is the minimal set of data containing the patient's ID, insurance number, and the standardised code representing the medical service provided" .

