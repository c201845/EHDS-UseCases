@prefix dpv: <https://w3id.org/dpv#> .
@prefix tech: <https://w3id.org/dpv/tech#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix ex: <https://w3id.org/examples#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sector-health: <https://w3id.org/dpv/ext/sector-health#> .

ex:RegionalDiagnosticEHRSystem a dpv:Technology ;
    dct:title "Cross-Border Diagnostic System" ;
    dct:description "EHR system infrastructure registered for supply in the EU health data space." ;
    
    tech:hasProvisionStatus eu-ehds:ServiceSupplyStatus ; 

    dpv:hasPurpose sector-health:DiagnosticSupport ;

    # Technical data categories monitored by the MSA to verify supply integrity
    dpv:hasData tech:Software .

# the Market Surveillance Authority manages the status
ex:NationalHealthMSA a dpv:Authority ;
    dct:title "National Market Surveillance Authority for Digital Health" ;
    # and the MSA tracks the overarching supply status of the tech
    dpv:isAuthorityFor ex:RegionalDiagnosticEHRSystem .

# The Ongoing Conformity Audit Activity
ex:MarketAvailabilityAudit a dpv:OrganisationalMeasure ;
    dct:title "Supply Chain Integrity Review" ;
    dpv:hasStatus dpv:ActivityOngoing ;
    dpv:hasEntity ex:NationalHealthMSA .
