@prefix dpv: <https://w3id.org/dpv#> .
@prefix tech: <https://w3id.org/dpv/tech#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix ex: <https://w3id.org/examples#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sector-health: <https://w3id.org/dpv/ext/sector-health#> .

ex:AIDiagnosticImageAnalysis a dpv:Technology ;
    dct:title "Artifical Intelligence (AI) Driven Diagnostic Imaging Analysis" ;
    dct:description "Advanced image analysis for secondary health data processing." ;
    
    dpv:hasStatus eu-ehds:PutIntoService ;
    
    dpv:hasPurpose sector-health:DiagnosisManagement .

ex:UniversityHospital a dpv:DataController ;
    dct:title "Central University Hospital" ;
    dpv:isImplementing ex:AIDiagnosticImageAnalysis .