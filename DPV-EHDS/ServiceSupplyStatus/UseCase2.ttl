@prefix dpv: <https://w3id.org/dpv#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix ex: <https://w3id.org/examples#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sector-health: <https://w3id.org/dpv/ext/sector-health#> .

ex:RemoteVitalsMonitoring a dpv:Technology ;
    dct:title "Remote Patient Vitals Monitoring Component" ;
   
    dpv:hasStatus eu-ehds:RecalledFromService ;
    dpv:hasPurpose sector-health:PatientMonitoring .

ex:HomeCare a dpv:DataController ;
    dct:title "Regional Home-Care Monitoring Service" ;
    dpv:isImplementing ex:RemoteVitalsMonitoring .

ex:RecallExecution a dpv:OrganisationalMeasure ;
    dct:title "Hardware Deactivation and Return Protocol" ;
    dpv:hasStatus dpv:ActivityCompleted .