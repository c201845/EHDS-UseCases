@prefix dpv: <https://w3id.org/dpv#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix ex: <https://w3id.org/examples#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:EHR-Sync-Failure a dpv:Risk ;
    dct:title "EHR Database Synchronisation Failure" ;
  
    dpv:hasIncident eu-ehds:SeriousIncident ;
    
    dpv:hasRiskSource ex:EHRSystem-Malfunction ;
   
    dpv:hasLikelihood dpv:ModerateLikelihood;
    dpv:hasSeverity risk:HighSeverity ;
    
    dpv:hasMitigationMeasure ex:EmergencyDataBackup .

ex:EHRSystem-Malfunction a risk:Vulnerability ;
    dct:title "EHR System Performance Deterioration" ;
    skos:note "Represents a malfunction or deterioration in characteristics as defined in the EHDS Art 2.2(r)." .
