@prefix dpv: <https://w3id.org/dpv#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix ex: <https://w3id.org/examples#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:ClinicalAlertFailure a dpv:Risk ;
    dct:title "Risk of Physical Harm from EHR Alert Malfunction" ;
    
    dpv:hasIncident eu-ehds:SeriousHealthIncident ;
    
    dpv:hasRiskSource ex:AlertLogicMalfunction ;
    
    dpv:hasConsequence risk:PhysicalHarm ;
    
    dpv:hasImpactOn dpv:DataSubject ;
    dpv:hasSeverity risk:ExtremelyHighSeverity ;
    dpv:hasLikelihood risk:LowLikelihood ;
    
    dpv:hasMitigationMeasure ex:ManualPharmacistValidation ;
    dpv:hasStatus dpv:ActivityOngoing .

ex:AlertLogicMalfunction a risk:Vulnerability ;
    dct:title “EHR System Performance Deterioration" ;

ex:ManualPharmacistValidation a dpv:OrganisationalMeasure ;
    dct:title "Secondary Manual Verification" ;
    dpv:hasStatus dpv:ActivityCompleted .