@prefix dpv: <https://w3id.org/dpv#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/eu-ehds#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://w3id.org/examples#> .

# Right of natural persons to opt out from primary use as Art. 10
ex:PatientOptOutPrimaryUse a dpv:RightExerciseRecord ;
    # the EHDS Right being exercised
    dpv:hasRight eu-ehds:A10 ;
    # the status of the request
    dpv:hasStatus dpv:RequestFulfilled ;
    # the individual exercising that right
    dpv:hasDataSubject ex:IndividualPatient ;
    # the authority responsible for implementing the opt-out preference
    dpv:hasRecipient ex:NationalHealthPortal ;
    
    # Contextual metadata: specifying the scope of the opt-out
    # Art. 10 targets the Electronic Health Data Access Services
    dpv:isApplicableTo ex:EHRSharingService ;

# the Service restricted
ex:EHRSharingService a dpv:Service ;
    dct:title "National EHR Access and Exchange Service" .
