@prefix dpv: <https://w3id.org/dpv#> .
@prefix eu-ehds: <https://w3id.org/dpv/ext/ehds#> .
@prefix sector-health: <https://w3id.org/dpv/sector/health#> .
@prefix ex: <https://w3id.org/examples#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PatientClinicalOnboarding a dpv:Process ;
    dct:title "Formal Registration of Patient Health Data" ;

    dpv:hasProcessing eu-ehds:RegistrationOfElectronicHealthData ;
  
    dpv:hasDataSource dpv:PublicDataSource ;

    dpv:hasRecipient ex:HospitalEHRSystem ;
    
    dpv:hasCompliance dpv:DataQualityManagement .
    dpv:hasPurpose sector-health:HealthcareManagement ;

eu-ehds:RegistrationOfElectronicHealthData a rdfs:Class, skos:Concept, dpv:Processing ;
    skos:prefLabel "Registration of Electronic Health Data"@en ;
    skos:definition " The recording of health data in an electronic format, through the manual entry of such data, through the collection of such data by a device, or through the conversion of non-electronic health data into an electronic format, to be processed in an EHR system or a wellness application."@en ;
    rdfs:subClassOf dpv:Obtain ;
    skos:broader dpv:Obtain ;
    dct:source "EHDS Regulation Article 2.2(g)"@en .