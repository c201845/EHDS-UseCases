@prefix dpv: <https://w3id.org/dpv#> .
@prefix sector-health: <https://w3id.org/dpv/sector/health#> .
@prefix eu-ehds: <https://w3id.org/dpv/legal/eu/ehds#> .
@prefix ex: <https://example.com/> .
@prefix dct: <http://purl.org/dc/terms/> .

# defining the Data Request
ex:PharmaSafetyRequest a eu-ehds:HealthDataRequest ;
  
  # Metadata for the request
    dpv:hasStatus dpv:RequestInitiated  ;
    dct:identifier “EHDS-REQ”  ;
    
   # identifying the request as a secondary use activity
    dpv:hasContext sector-health:SecondaryUse  ;

    # mapping actor to the EHDS role
    dpv:hasRecipient [
        a eu-ehds:HealthDataUser  ;
        dpv:hasName "GlobalPharmacy Ltd”  ;
	dpv:hasEntityLocation <https://w3id.org/loc/EU>
    ] ;
    
    # defining the purpose validated against permitted uses
    dpv:hasPurpose sector-health:PublicHealthMonitoring, 
                    sector-health:PostMarketSurveillance  ;

    # defining the actual data requested 
    dpv:hasData sector-health:ElectronicHealthData,
                 sector-health:HealthAggregatedData  ;

    # defining the the technical safeguard - Secure Processing Environment
    dpv:hasTechnicalMeasure sector-health:SecureProcessingEnvironment  ;

    # defining the Legal Basis for secondary use under EHDS
    dpv:hasLegalBasis dpv:PublicInterest  ;  #instead of dpv:PublicInterest should I consider dpv-gdpr:A6-1-e-public-interest

    # defining the processing operations the use will do
    dpv:hasProcessing dpv:Analyse, dpv:Aggregate  ;
    
    # defining the specific constraint: the prohibition on re-identification
    dpv:hasRule [
        a dpv:Prohibition  ;
        dpv:hasProcessing dpv:Reidentify  ;
        dct:description “Re-identification of natural persons is strictly prohibited under EHDS secondary use rules.” @en
    ] .
.
