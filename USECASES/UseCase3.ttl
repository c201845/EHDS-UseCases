@prefix dpv: <https://w3id.org/dpv#> .
@prefix sector-health: <https://w3id.org/dpv/sector/health#> .
@prefix ex: <https://example.org/> .
@prefix dct: <http://purl.org/dc/terms/> .

ex:DiagnosticTrainingActivity a dpv:Process ;

   # Status: Indicates the technical process is currently active
    dpv:hasStatus dpv:ActivityOngoing ;
    dpv:hasPurpose sector-health:TrainTestAndEvaluateHealthRelatedAlgorithms,
                    sector-health:DiagnosticOptimisation ;

   # Implementation technology
    dpv:isImplementedUsingTechnology sector-health:ElectronicHealthRecordSystem ;
    
    # defining the specific data types
    dpv:hasPersonalData sector-health:MedicalImaging, 
                 sector-health:PersonalElectronicHealthData ;
    
    # defining the Legal Basis for secondary use under EHDS
    dpv:hasLegalBasis dpv:PublicInterest ;  #instead of dpv:PublicInterest should I consider replacing it with a specific GDPR legal basis such as eu-gdpr:A6-1-e-public-interest 
                                            #to make the legal basis precise for the scenario since now the current placeholder is used to demonstrates the activity is conducted in the public interest such 
                                            #such as improving diagnostic tools for patient care. Currently, as the DPV extension for EHDS does not yet
                                            # define specific legal basis concepts for secondary use. As a result, for the modeling I should rely on the GDPR-based legal bases.
   
    # defining the processing operations
    dpv:hasProcessing dpv:Analyse, dpv:Train ;
    
    # Technical Safeguard: Mandatory SPE for pseudonymised data
    dpv:hasTechnicalMeasure sector-health:SecureProcessingEnvironment ;

    # Actor: The entity managing the processing within the SPE
    dpv:hasDataProcessor ex:DiagnosticAICompany .

ex:DiagnosticAICompany a dpv:ForProfitOrganisation, dpv:DataProcessor .


